# =============================================================================
# OpenRouter (LLM + image + video, single vendor for all generation)
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models (override to swap between SOTA models without code changes)
OPENROUTER_LLM_MODEL=openai/gpt-5
OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0
OPENROUTER_VLM_MODEL=openai/gpt-5

# Optional OpenRouter app metadata (shows up in their dashboards)
OPENROUTER_APP_NAME=oc-mill
OPENROUTER_APP_URL=https://github.com/ferine/oc-mill

# =============================================================================
# ElevenLabs (TTS narration, per-mood voice mapping)
# =============================================================================
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_MODEL=eleven_multilingual_v2

# Per-mood voice IDs (override any of these to retune the brand voices)
ELEVENLABS_VOICE_HEARTWARMING=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_FUNNY=AZnzlk1XvdvUeBnXmlld
ELEVENLABS_VOICE_DRAMATIC=ErXwobaYiN019PkySvjV
ELEVENLABS_VOICE_SAD=MF3mGyEYCl7XYWbV9V6O
ELEVENLABS_VOICE_HOPEFUL=TxGEqnHWrfWFTfGW9XjX
ELEVENLABS_VOICE_EPIC=VR6AewLTigWG4xSOukaG

# =============================================================================
# TikTok Content Posting API
# =============================================================================
TIKTOK_API_KEY=your_tiktok_access_token_here
TIKTOK_BASE_URL=https://open.tiktokapis.com
TIKTOK_VISIBILITY=public

# =============================================================================
# Pipeline settings
# =============================================================================
VIDEO_DURATION_SECONDS=55
VIDEO_ASPECT_RATIO=9:16
VIDEO_DOWNLOAD_PATH=/tmp/oc-mill-videos

# Per-scene clip generation
CLIP_DURATION_SECONDS=7
SCENE_CONCURRENCY=2

# Async polling for video generation jobs
MAX_POLL_ATTEMPTS=120
POLL_INTERVAL_MS=10000

# Eval gate (VLM scene QA)
EVAL_RETRIES_PER_SCENE=1

# Character reference cache directory
CHARACTER_REF_DIR=/tmp/oc-mill-character-refs

# =============================================================================
# Scheduling
# =============================================================================
RUN_INTERVAL_HOURS=24
AUTO_RUN=false

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
