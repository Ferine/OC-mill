# =============================================================================
# OpenRouter (LLM + image + video + VLM + TTS — single vendor for everything)
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models (override to swap between SOTA models without code changes)
OPENROUTER_LLM_MODEL=openai/gpt-5
OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0
OPENROUTER_VLM_MODEL=openai/gpt-5
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
# Audio output format the TTS endpoint should return. Gemini TTS only
# accepts "pcm" (the service wraps it in a WAV container on save). For
# other models you can use "mp3", "opus", "wav", "aac", or "flac".
OPENROUTER_TTS_FORMAT=pcm

# Optional OpenRouter app metadata (shows up in their dashboards)
OPENROUTER_APP_NAME=oc-mill
OPENROUTER_APP_URL=https://github.com/ferine/oc-mill

# =============================================================================
# TTS (per-mood voice mapping)
# =============================================================================
# Defaults below are Gemini 3.1 Flash TTS prebuilt voice names. If you swap
# OPENROUTER_TTS_MODEL to a different provider, set these to that provider's
# voice IDs.
TTS_VOICE_HEARTWARMING=Aoede
TTS_VOICE_FUNNY=Puck
TTS_VOICE_DRAMATIC=Charon
TTS_VOICE_SAD=Leda
TTS_VOICE_HOPEFUL=Kore
TTS_VOICE_EPIC=Fenrir

# =============================================================================
# TikTok Content Posting API
# =============================================================================
TIKTOK_API_KEY=your_tiktok_access_token_here
TIKTOK_BASE_URL=https://open.tiktokapis.com
TIKTOK_VISIBILITY=public

# =============================================================================
# Pipeline settings
# =============================================================================
VIDEO_DURATION_SECONDS=55
VIDEO_ASPECT_RATIO=9:16
VIDEO_DOWNLOAD_PATH=/tmp/oc-mill-videos

# Per-scene clip generation
CLIP_DURATION_SECONDS=7
SCENE_CONCURRENCY=2

# Async polling for video generation jobs
MAX_POLL_ATTEMPTS=120
POLL_INTERVAL_MS=10000

# Eval gate (VLM scene QA)
EVAL_RETRIES_PER_SCENE=1

# Character reference cache directory
CHARACTER_REF_DIR=/tmp/oc-mill-character-refs

# =============================================================================
# Scheduling
# =============================================================================
RUN_INTERVAL_HOURS=24
AUTO_RUN=false

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
