{
  "name": "oc-mill",
  "version": "1.0.0",
  "description": "AI Fat Orange Cat Story Agent - Automated TikTok content generation",
  "main": "dist/index.js",
  "scripts": {
    "build:server": "tsc",
    "build:web": "pnpm --filter oc-mill-web build",
    "build": "pnpm build:server && pnpm build:web",
    "start": "node dist/index.js",
    "serve": "node dist/index.js --server",
    "dev": "ts-node src/index.ts",
    "dev:web": "pnpm --filter oc-mill-web dev",
    "watch": "tsc --watch",
    "clean": "rm -rf dist web/dist",
    "type-check": "tsc --noEmit && pnpm --filter oc-mill-web exec tsc --noEmit"
  },
  "keywords": [
    "ai",
    "tiktok",
    "video-generation",
    "automation",
    "kling-ai"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^4.67.0",
    "winston": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
